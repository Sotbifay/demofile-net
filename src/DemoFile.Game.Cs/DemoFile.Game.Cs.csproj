<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net9.0;netstandard2.1</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>DemoFile</RootNamespace>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <IsPackable>true</IsPackable>
    <!-- CS1591: Missing XML comment for publicly visible type or member -->
    <!-- CS1591: CS0618 : 'x' is obsolete -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);CS1591;CS0618</WarningsNotAsErrors>
    <IsAotCompatible Condition="'$(TargetFramework)' != 'netstandard2.1'">true</IsAotCompatible>
  </PropertyGroup>

  <PropertyGroup>
    <Description>DemoFile.Game.Cs is a blazing fast Counter-Strike 2 demo parser library.</Description>
  </PropertyGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DemoFile.Test" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DemoFile\DemoFile.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.22.1" />
    <PackageReference Include="protobuf-net" Version="3.2.16" Condition="'$(TargetFramework)' != 'netstandard2.1'" />
    <PackageReference Include="Grpc.Tools" Version="2.40.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Unity (Mono / IL2CPP) build: polyfills for APIs missing from netstandard2.1 -->
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.1'">
    <PackageReference Include="PolySharp" Version="1.15.0" PrivateAssets="all" />
    <Compile Include="..\DemoFile\Polyfills\Attributes.cs" Link="Polyfills\Attributes.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' != 'netstandard2.1'">
    <Compile Remove="Polyfills/**" />
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="Protobufs/usercmd.proto" ProtoRoot="Protobufs" />
    <Protobuf Include="Protobufs/cs_usercmd.proto" ProtoRoot="Protobufs" />
    <Protobuf Include="Protobufs/cs_gameevents.proto" ProtoRoot="Protobufs" />
    <Protobuf Include="Protobufs/cstrike15_usermessages.proto" ProtoRoot="Protobufs" />
    <Protobuf Include="Protobufs/cstrike15_gcmessages.proto" ProtoRoot="Protobufs" />
    <Protobuf Include="Protobufs/steammessages.proto" ProtoRoot="Protobufs" />
    <Protobuf Include="Protobufs/engine_gcmessages.proto" ProtoRoot="Protobufs" />
    <Protobuf Include="Protobufs/gcsdk_gcmessages.proto" ProtoRoot="Protobufs" />
  </ItemGroup>

</Project>
