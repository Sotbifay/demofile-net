<Project Sdk="Microsoft.NET.Sdk">
  <!-- Unity build: DemoFile compiled for netstandard2.1 with the polyfills -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Dump.cs;../Program.cs" />
    <ProjectReference Include="../../../src/DemoFile.Game.Cs/DemoFile.Game.Cs.csproj" SetTargetFramework="TargetFramework=netstandard2.1" />
    <!-- Explicit, or the transitive reference resolves DemoFile to net9.0 and mixes the two builds -->
    <ProjectReference Include="../../../src/DemoFile/DemoFile.csproj" SetTargetFramework="TargetFramework=netstandard2.1" />
  </ItemGroup>
</Project>
